# Serviços locais. Configure câmera e destinatário pelo dashboard.
HOST=127.0.0.1
PORT=8000
WA_PORT=3001
CAMERA_SOURCE=rtsp://127.0.0.1:8554/cam   # o assistente do painel pede o endereço real
YOLO_MODEL=yolo26n.pt
REID_MODEL=yolo26n-reid.onnx
POSE_MODEL=yolo26n-pose.pt
FACE_DETECTOR=face_detection_yunet_2023mar.onnx
FACE_ENCODER=face_recognition_sface_2021dec.onnx
# Opcional: na primeira execução sem usuários, cria o administrador "admin" com esta senha.
# Depois, gerencie usuários e senhas na página Usuários do painel.
DASHBOARD_PASSWORD=
# Endereço HTTPS do Tailscale Serve (scripts/setup-tailscale.sh preenche).
PUBLIC_URL=
# INFO ou DEBUG
LOG_LEVEL=INFO
# Contato (mailto:... ou https://...) enviado aos serviços de notificação push. Em instalações vendidas, use o do suporte.
PUSH_CONTACT=
# Plano comercial do Open-Meteo (clima do totem). Vazio = API gratuita, só para uso NÃO comercial.
OPEN_METEO_API_KEY=
